{
  "manifest_version": 3,
  "name": "Inventory Order Import",
  "version": "0.2.0",
  "description": "Copy order lines from supported supplier pages as CSV.",
  "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"],
  "host_permissions": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Copy order CSV",
    "default_popup": "popup.html"
  }
}
