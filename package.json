{
  "name": "inventory-tracker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun --bun --env-file .env vite dev",
    "build": "bun --bun --env-file .env vite build",
    "preview": "bun --bun --env-file .env vite preview",
    "start": "bun --env-file .env ./build/index.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "bun --bun node_modules/vitest/vitest.mjs",
    "test": "bun run test:unit -- --run",
    "check:live-import": "LIVE_IMPORT_CHECK=1 bun --bun --env-file .env node_modules/vitest/vitest.mjs --run --project server src/lib/server/imports/live-check.spec.ts",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "ai": "^7.0.127",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.4.2",
    "@vitest/browser-playwright": "^4.1.8",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright": "^1.60.0",
    "svelte": "^5.56.7",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  }
}
